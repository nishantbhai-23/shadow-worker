# Telegram
TELEGRAM_BOT_TOKEN=
# Random secret used to claim the bot once via a deep link (t.me/yourbot?start=<this value>)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(16))"
TELEGRAM_START_SECRET=

# Database (Neon connection string, asyncpg-compatible)
# postgresql+asyncpg://user:password@host/dbname
DATABASE_URL=

# LLM provider: "anthropic" or "openai_compatible"
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
# Only needed for openai_compatible (DeepSeek: https://api.deepseek.com, Ollama: http://localhost:11434/v1)
LLM_BASE_URL=

# Daily digest push time (24h, local to TZ below)
DIGEST_HOUR=7
TZ=UTC
